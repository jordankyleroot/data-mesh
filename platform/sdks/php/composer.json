{
  "name": "datamesh/sdk",
  "description": "Data Mesh PHP SDK – Avro producers and schema registry client",
  "type": "library",
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.0",
    "ramsey/uuid": "^4.0",
    "flix-tech/avro-serde-php": "^1.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "DataMesh\\SDK\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DataMesh\\Tests\\": "tests/"
    }
  }
}
